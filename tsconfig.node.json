{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023"], "module": "NodeNext",
    "moduleResolution": "NodeNext", "strict": true, "noUncheckedIndexedAccess": true,
    "noEmit": true, "skipLibCheck": true, "types": ["node"], "esModuleInterop": true,
    "allowImportingTsExtensions": true, "verbatimModuleSyntax": true, "erasableSyntaxOnly": true
  },
  "include": ["src/cli.ts", "src/cli", "src/hosts/codex", "src/hosts/claude/launch-node.ts", "src/outputs", "tests/node"]
}
