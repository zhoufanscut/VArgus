{
  // Copy this file to vargus.jsonc in the VArgus checkout.
  // Uncomment the options you want to change. The values shown are the defaults.

  // Session display
  // "folder": true,         // Show the working folder.
  // "folderFoldThreshold": 24,  // Fold longer paths to .../parent/folder (terminal columns).
  // "model": true,          // Show the model name.
  // "effort": true,         // Include reasoning effort beside the model.
  // "context": true,        // Show the percentage of the context window used.
  // "tokens": true,         // Show session tokens, latest prompt-cache hit rate and output speed (t/s).
  // "session": true,        // Show elapsed session time.
  // "callCounts": true,     // Show tool, agent and skill counts where available.
  // "includeSubagents": true,  // Include subagent tokens, tools, agents and skills.

  // Rate limits
  // "rateLimits": true,        // Show usage and reset times for available limits.

  // Repository display
  // "repo": true,           // Show the repository name.
  // "branch": true,         // Show the branch name, detached checkout ref, or short commit ID.
  // "status": true,         // Show working-tree changes and ahead/behind counts.

  // Codex
  // "codexAutoStart": true,   // Let the installed startup hooks activate VArgus.

  // Choose graphite, aurora, ember, nebula, tokyo-night, codex-ink, claude-terracotta, omo-violet or daylight (run `vargus themes` to preview).
  "theme": "graphite"
}
