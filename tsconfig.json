{
  "compilerOptions": {
    "target": "es2023",
    "lib": [
      "es2023"
    ],
    "types": [],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment"
  },
  "include": [
    ".claude-plugin/types",
    "hooks",
    "src",
    "types",
    "tests"
  ],
  "exclude": [
    "src/cli.ts",
    "src/hosts/codex",
    "src/hosts/claude/launch-node.ts",
    "src/outputs/tmux",
    "tests/node"
  ]
}
